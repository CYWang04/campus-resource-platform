# Use scripts/init-local.ps1 (Windows) or scripts/init-local.sh (macOS/Linux) so the
# database and service secrets below are generated independently for each member.
MYSQL_ROOT_PASSWORD=replace-with-local-random-hex
M1_DB_PASSWORD=replace-with-local-random-hex
M2_DB_PASSWORD=replace-with-local-random-hex
M3_DB_PASSWORD=replace-with-local-random-hex
SERVICE_KEY=replace-with-at-least-32-local-random-characters

# Public test-only credential, intentionally committed for team acceptance.
DEMO_PASSWORD=CampusDemo2026!
