{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Environment: Check installed tools",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/check-environment.ps1"
      ],
      "osx": {
        "command": "/bin/zsh",
        "args": ["-lc", "bash scripts/check-environment.sh"]
      },
      "linux": {
        "command": "bash",
        "args": ["scripts/check-environment.sh"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Environment: Check tools and Docker Engine",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/check-environment.ps1",
        "-CheckDockerEngine"
      ],
      "osx": {
        "command": "/bin/zsh",
        "args": ["-lc", "bash scripts/check-environment.sh --docker"]
      },
      "linux": {
        "command": "bash",
        "args": ["scripts/check-environment.sh", "--docker"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
